{
  "name": "morrow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "lint": "eslint src tests vite.config.ts capacitor.config.ts",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/data.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "android:sync": "npm run build:android && cap sync android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "dexie": "^4.4.3",
    "lucide-react": "1.17.0",
    "motion": "^14.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-virtuoso": "4.18.7",
    "vite-plugin-pwa": "1.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "description": "Morrow — make room for tomorrow. Offline-first funded budgets."
}
