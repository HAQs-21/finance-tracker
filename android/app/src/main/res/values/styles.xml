<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MorrowTheme.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/morrow_background</item>
        <item name="colorPrimaryDark">@color/morrow_background</item>
        <item name="colorAccent">@color/morrow_copper</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/morrow_background</item>
        <item name="android:navigationBarColor">@color/morrow_background</item>
        <item name="android:windowBackground">@color/morrow_background</item>
    </style>

    <style name="AppTheme" parent="MorrowTheme.Base" />

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/morrow_background</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/morrow_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/morrow_mark_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
